# CRLF breaks shebangs on Linux ("bad interpreter"), and Windows checks out CRLF by default.
# These files run inside containers or CI, so they must stay LF.
**/docker-entrypoint.sh     text eol=lf
**/Dockerfile               text eol=lf
**/.dockerignore            text eol=lf
render.yaml                 text eol=lf
.github/workflows/*.yml     text eol=lf
