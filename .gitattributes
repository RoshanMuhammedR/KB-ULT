# CRLF breaks shebangs on Linux ("bad interpreter"), and Windows checks out CRLF by default.
# These files run inside containers or on the VPS, so they must stay LF.
deploy/*.sh              text eol=lf
**/docker-entrypoint.sh  text eol=lf
**/Dockerfile            text eol=lf
.github/workflows/*.yml  text eol=lf
deploy/Caddyfile         text eol=lf
