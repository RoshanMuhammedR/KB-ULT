# Template for /opt/saga/.env on the VPS. NEVER commit the real file — CI rsyncs this
# directory with `--exclude '.env'` precisely so the server's secrets survive a deploy.
#
# Generate secrets ON THE SERVER so they never touch a shell history, chat log, or repo:
#   sed -i "s|REPLACE_ME|$(openssl rand -hex 32)|" .env
# Use hex, not base64 — no /, +, = or $ to confuse compose interpolation or a URL.

# The host port AIC's panel forwards your domain to. Must match the panel exactly.
APP_PORT=3002
APP_BASE_URL=https://saga.example.com

# GHCR account that owns the images (lowercase).
GHCR_OWNER=your-github-username
# Managed by deploy.sh — it rewrites this line on every rollout.
IMAGE_TAG=latest

POSTGRES_DB=saga
POSTGRES_USER=saga
POSTGRES_PASSWORD=REPLACE_ME

# HS256 signing key for access tokens. Rotating it invalidates every live session.
JWT_SECRET=REPLACE_ME
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

AICREDITS_API_KEY=sk-your-aicredits-key
AICREDITS_BASE_URL=https://api.aicredits.in/v1
AICREDITS_CHAT_MODEL=openai/gpt-4o-mini
AICREDITS_EMBEDDING_MODEL=text-embedding-3-small

FILEBASE_ACCESS_KEY=your-filebase-access-key
FILEBASE_SECRET_KEY=your-filebase-secret-key
FILEBASE_BUCKET_NAME=your-filebase-bucket
FILEBASE_ENDPOINT=https://s3.filebase.io
