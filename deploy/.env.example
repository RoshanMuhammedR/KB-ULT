# Rendered into /opt/stack/kb/.env on the VPS by the deploy workflow.
# Never committed with real values - this file only documents what's expected.

GHCR_OWNER=your-github-username
IMAGE_TAG=latest

# Shared Postgres instance - this app's own database/role within it
POSTGRES_DB=kb
APP_DB_USER=kb_app
APP_DB_PASSWORD=

APP_BASE_URL=http://37.187.140.45:8082
# Comma-separated list the API accepts Origin headers from. Not used to build any link -
# apps/web and apps/website default to relative paths (/api, /app, /) when their
# NEXT_PUBLIC_* build-args are unset, so this only matters for direct cross-origin API
# callers (e.g. a future mobile client), not the browser flow through Caddy.
CORS_ALLOWED_ORIGINS=http://37.187.140.45:8082,http://saga.dedyn.io,https://saga.dedyn.io
JWT_SECRET=

AICREDITS_API_KEY=
AICREDITS_BASE_URL=https://api.aicredits.in/v1
AICREDITS_CHAT_MODEL=openai/gpt-4o-mini
AICREDITS_EMBEDDING_MODEL=text-embedding-3-small

# YouTube blocks transcript requests from datacenter IP ranges, which is exactly what this
# VPS is - so YouTube sources will fail here until one of these is set, even though the
# same code works from a laptop. Webshare wins when both are set.
YOUTUBE_PROXY_URL=
YOUTUBE_WEBSHARE_USERNAME=
YOUTUBE_WEBSHARE_PASSWORD=

FILEBASE_ACCESS_KEY=
FILEBASE_SECRET_KEY=
FILEBASE_BUCKET_NAME=
FILEBASE_ENDPOINT=https://s3.filebase.io
