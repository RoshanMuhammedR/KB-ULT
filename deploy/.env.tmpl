# Template for /opt/saga/.env — rendered by .github/workflows/deploy.yml on every rollout.
#
# The rendered file on the server is a GENERATED ARTIFACT: editing it by hand works until
# the next deploy overwrites it. Change values in GitHub instead:
#   Settings -> Secrets and variables -> Actions
#     secrets   -> POSTGRES_PASSWORD, JWT_SECRET, AICREDITS_API_KEY, FILEBASE_*
#     variables -> APP_PORT, APP_BASE_URL, GHCR_OWNER, POSTGRES_DB, POSTGRES_USER, ...
#
# Anything non-secret lives as a *variable* so it stays readable and reviewable; only real
# credentials are secrets.
#
# IMAGE_TAG is written here purely so a human running `docker compose ps` in this directory
# sees the right image. The ROLLBACK TARGET is not this line — it is .image-tag, which
# deploy.sh owns and CI never touches, because this file is regenerated on every rollout.
# deploy.sh exports IMAGE_TAG, and an exported variable beats the .env file in compose
# interpolation, so the two can never disagree during a deploy.
IMAGE_TAG=${IMAGE_TAG}

APP_PORT=${APP_PORT}
APP_BASE_URL=${APP_BASE_URL}
GHCR_OWNER=${GHCR_OWNER}

POSTGRES_DB=${POSTGRES_DB}
POSTGRES_USER=${POSTGRES_USER}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}

JWT_SECRET=${JWT_SECRET}
ACCESS_TOKEN_TTL_SECONDS=${ACCESS_TOKEN_TTL_SECONDS}
REFRESH_TOKEN_TTL_SECONDS=${REFRESH_TOKEN_TTL_SECONDS}

AICREDITS_API_KEY=${AICREDITS_API_KEY}
AICREDITS_BASE_URL=${AICREDITS_BASE_URL}
AICREDITS_CHAT_MODEL=${AICREDITS_CHAT_MODEL}
AICREDITS_EMBEDDING_MODEL=${AICREDITS_EMBEDDING_MODEL}

FILEBASE_ACCESS_KEY=${FILEBASE_ACCESS_KEY}
FILEBASE_SECRET_KEY=${FILEBASE_SECRET_KEY}
FILEBASE_BUCKET_NAME=${FILEBASE_BUCKET_NAME}
FILEBASE_ENDPOINT=${FILEBASE_ENDPOINT}

# PDF parsing cost. Table structure runs a second torch model (TableFormer) across every
# detected table on top of the per-page layout model — the dominant cost of ingestion on
# 2 vCPU — so it is off by default and tables arrive as flowed text. Set the
# DOCLING_DO_TABLE_STRUCTURE Actions variable to "true" if structured tables matter more
# than latency for your corpus. Empty values are fine: compose defaults these.
DOCLING_DO_TABLE_STRUCTURE=${DOCLING_DO_TABLE_STRUCTURE}
DOCLING_NUM_THREADS=${DOCLING_NUM_THREADS}
DOCLING_TIMEOUT_SECONDS=${DOCLING_TIMEOUT_SECONDS}
