POSTGRES_DB=kb_new
POSTGRES_USER=kb_user
POSTGRES_PASSWORD=kb_password
POSTGRES_PORT=5432

# Non-superuser role the app's ORM sessions use so Postgres RLS applies (create it with
# `pnpm run db:app-role`). Leave APP_DATABASE_URL unset to run ORM sessions as the
# superuser above — the ORM tenant-filter still enforces isolation, but RLS is dormant.
APP_DB_PASSWORD=kb_app_password
# APP_DATABASE_URL=postgresql+psycopg://kb_app:kb_app_password@localhost:5432/kb_new

# Auth: HS256 signing secret for access tokens — MUST be overridden with a long random
# value in every real environment. Accounts are email + password; there is no tenant domain.
JWT_SECRET=dev-insecure-change-me-in-every-real-environment-0123456789
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Cache (Redis/Valkey — same protocol). Now on the query path: query embeddings, rerank
# verdicts and semantically-matched answers. All tenant-scoped except the embedding
# cache, which is keyed on content and therefore safe to share.
CACHE_URL=redis://localhost:6379/0
CACHE_PORT=6379

API_PORT=8000
WEB_PORT=3000
WEBSITE_PORT=3001
# In production these are relative (one origin behind Caddy: /api and /app). In dev each app
# runs on its own port, so they are absolute.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_PRODUCT_URL=http://localhost:3000/app
# Where the product app's auth pages link back to for marketing.
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3001
# Dev only: in production the browser reaches the API same-origin, so CORS never applies.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001

AICREDITS_API_KEY=sk-your-aicredits-key
AICREDITS_BASE_URL=https://api.aicredits.in/v1
AICREDITS_CHAT_MODEL=openai/gpt-4o-mini
AICREDITS_EMBEDDING_MODEL=text-embedding-3-small
# Hosted speech-to-text for audio sources. Nothing runs locally.
# Must be a model the gateway serves on /audio/transcriptions — that route's model set is
# much smaller than the /v1/models catalog (which is the chat catalog).
AICREDITS_TRANSCRIPTION_MODEL=openai/whisper-1
EMBEDDING_DIMENSIONS=1536
# Audio is transcribed by a paid hosted model, so it alone carries an upload cap (100MB).
MAX_AUDIO_UPLOAD_BYTES=104857600

# Google sign-in. Only the public client id is needed — the browser-side ID-token flow
# uses no client secret. Leave both blank to disable it: the API returns 503 and the apps
# render no Google button, so local dev works without Google credentials.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# 300-600 tokens is the band where a chunk matches precisely and still reads on its own.
# It was 800 when a chunk had to be both the retrieval unit and the generation unit;
# parent expansion (small-to-big) means it no longer does.
CHUNK_SIZE_TOKENS=450
CHUNK_OVERLAP_TOKENS=70
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.25
RETRIEVAL_MIN_CONTEXT_CHUNKS=2

FILEBASE_ACCESS_KEY=your-filebase-access-key
FILEBASE_SECRET_KEY=your-filebase-secret-key
FILEBASE_BUCKET_NAME=your-filebase-bucket
FILEBASE_ENDPOINT=https://s3.filebase.io

# --- Agentic retrieval -------------------------------------------------------------
# The small model behind the pipeline's mechanical steps: query resolution, reranking,
# sufficiency, grounding, and the per-section blurb written at ingestion. These run several
# times per question and are judged on latency, so keep this cheap. The answering model
# (AICREDITS_CHAT_MODEL) is what writes the prose a user reads.
AICREDITS_FAST_MODEL=openai/gpt-4o-mini
# Two hops. A question that survives two well-formed retrievals is usually one the corpus
# cannot answer; a third buys latency and a more elaborate wrong answer.
MAX_RETRIEVAL_HOPS=2
RERANK_TOP_N=6
RERANK_TIMEOUT_SECONDS=2.5
# Relevance floor after reranking. ASR text scores lower than typed prose at identical
# usefulness, so transcripts get their own bar rather than being silently dropped.
RERANK_RELEVANCE_THRESHOLD=0.35
RERANK_ASR_RELEVANCE_THRESHOLD=0.25
CONTEXT_TOKEN_BUDGET=8000
# One model call per section at ingestion, describing it so its chunks embed with context.
ENRICH_CHUNKS=1
# Verify citations before streaming instead of after. Costs ~1.5s on every answer and
# forces the whole response to be buffered, so it is off unless being slow beats being wrong.
GROUNDING_BLOCKING=0

# --- Tracing (Langfuse) ------------------------------------------------------------
# Empty keys disable tracing entirely; nothing else changes. Sign up at cloud.langfuse.com
# or point LANGFUSE_HOST at a self-hosted instance.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
