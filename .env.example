POSTGRES_DB=kb_new
POSTGRES_USER=kb_user
POSTGRES_PASSWORD=kb_password
POSTGRES_PORT=5432

# Non-superuser role the app's ORM sessions use so Postgres RLS applies (create it with
# `pnpm run db:app-role`). Leave APP_DATABASE_URL unset to run ORM sessions as the
# superuser above — the ORM tenant-filter still enforces isolation, but RLS is dormant.
APP_DB_PASSWORD=kb_app_password
# APP_DATABASE_URL=postgresql+psycopg://kb_app:kb_app_password@localhost:5432/kb_new

# Auth: HS256 signing secret for access tokens — MUST be overridden with a long random
# value in every real environment. Accounts are email + password; there is no tenant domain.
JWT_SECRET=dev-insecure-change-me-in-every-real-environment-0123456789
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Cache (Valkey). Nothing reads it today — the port and adapter are kept for the next
# feature that needs a cache.
CACHE_URL=redis://localhost:6379/0
CACHE_PORT=6379

API_PORT=8000
WEB_PORT=3000
WEBSITE_PORT=3001
# In production these are relative (one origin behind Caddy: /api and /app). In dev each app
# runs on its own port, so they are absolute.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_PRODUCT_URL=http://localhost:3000/app
# Where the product app's auth pages link back to for marketing.
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3001
# Dev only: in production the browser reaches the API same-origin, so CORS never applies.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001

AICREDITS_API_KEY=sk-your-aicredits-key
AICREDITS_BASE_URL=https://api.aicredits.in/v1
AICREDITS_CHAT_MODEL=openai/gpt-4o-mini
AICREDITS_EMBEDDING_MODEL=text-embedding-3-small
# Hosted speech-to-text for audio sources. Nothing runs locally.
AICREDITS_TRANSCRIPTION_MODEL=mistralai/voxtral-small-24b-2507
EMBEDDING_DIMENSIONS=1536
# Audio is transcribed by a paid hosted model, so it alone carries an upload cap (100MB).
MAX_AUDIO_UPLOAD_BYTES=104857600

# Google sign-in. Only the public client id is needed — the browser-side ID-token flow
# uses no client secret. Leave both blank to disable it: the API returns 503 and the apps
# render no Google button, so local dev works without Google credentials.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.25
RETRIEVAL_MIN_CONTEXT_CHUNKS=2

FILEBASE_ACCESS_KEY=your-filebase-access-key
FILEBASE_SECRET_KEY=your-filebase-secret-key
FILEBASE_BUCKET_NAME=your-filebase-bucket
FILEBASE_ENDPOINT=https://s3.filebase.io
